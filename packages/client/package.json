{
  "name": "@yifunxxx/qipai-cli",
  "version": "0.1.1",
  "description": "终端棋牌大厅客户端：陕西麻将与十点半",
  "type": "module",
  "bin": {
    "yifunqipai": "./bin/yifunqipai.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --dir ../shared run build && node ./scripts/build.mjs",
    "start": "tsx src/cli.ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/ws/client.test.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@yifun/qipai-shared": "workspace:*",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mahjong", "poker", "tui", "cli", "qipai"],
  "license": "MIT"
}
